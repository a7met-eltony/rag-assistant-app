# Copy this file to .env. NEVER commit .env (it is in .gitignore).

# URL of the FastAPI backend (127.0.0.1 on purpose: on Windows "localhost" can resolve to IPv6).
API_BASE_URL=http://127.0.0.1:8000

# How long to wait for an answer. The local LLM can be slow on a CPU; keep this above the backend's OLLAMA_TIMEOUT (120).
REQUEST_TIMEOUT_SECONDS=150
