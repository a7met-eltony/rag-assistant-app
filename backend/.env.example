# Copy this file to .env. NEVER commit .env (it is in .gitignore).

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501,http://localhost:7860,http://127.0.0.1:8501,http://127.0.0.1:7860

# Ollama (local LLM). 127.0.0.1 on purpose: on Windows "localhost" can resolve to IPv6, where Ollama does not listen.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT=120
TEMPERATURE=0.0
NUM_CTX=4096

# The vector store folder is AUTO-DETECTED (backend/data/vector_store or <project>/data/vector_store).
# Optional overrides (if commented out, the values saved by the notebook in config.json are used):
# VECTOR_STORE_DIR=
# OLLAMA_MODEL=llama3.2
# TOP_K=5
# MIN_SIMILARITY=0.25
